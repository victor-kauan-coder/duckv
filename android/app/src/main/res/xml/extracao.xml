<?xml version="1.0" encoding="utf-8"?>
<!-- A chave do pareamento comanda o computador: nao vai para backup na nuvem nem para outro celular
     numa transferencia. Num aparelho novo, e so parear de novo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
