<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x1: o pato, "Nova sessao" e o botao +. Tocar em qualquer parte abre a folha rapida. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:contentDescription="@string/widget_descricao"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="33dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/pato_widget" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_titulo"
            android:textColor="@color/widget_texto"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_apoio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_apoio"
            android:textColor="@color/widget_apoio"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_botao"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_mais" />
</LinearLayout>
